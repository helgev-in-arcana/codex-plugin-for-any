{
  "name": "codex-plugin-for-any",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Universal Agent Skill and companion CLI for using OpenAI Codex from Antigravity and any other coding agent.",
  "license": "Apache-2.0",
  "bin": {
    "codex-companion": "./skills/codex/scripts/codex-companion.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "prebuild": "mkdir -p .generated/app-server-types && codex app-server generate-ts --out .generated/app-server-types",
    "build": "tsc -p tsconfig.app-server.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
